# CodeOps — environment variables
# Copy to .env for local development. On Render, set these in the service dashboard.
# The only required variables are DATABASE_URL and BETTER_AUTH_SECRET. Everything
# else is optional and unlocks a feature when set.

# --- Required ---
# MySQL connection string. Local: the Docker MySQL from the README.
# Production: any MySQL-compatible host (PlanetScale, TiDB Cloud, Aiven, Railway,
# or a self-hosted MySQL 8). Render has no managed MySQL — this must be external.
DATABASE_URL=mysql://local:local@127.0.0.1:3306/codeops
# Better Auth signing secret — generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Runtime ---
# Public URL of THIS server (the API). Defaults to http://localhost:3000. Set it
# to the real URL in production (e.g. https://codeops.onrender.com) — Better Auth
# uses it for redirects, cookies, and email links, and the GitHub connect button
# derives its target from it.
BETTER_AUTH_URL=http://localhost:3000
# Port the HTTP server binds. Render injects its own PORT; local default is 3000.
PORT=3000
# Runtime environment. Render sets this; local dev defaults to development.
NODE_ENV=development

# --- Split deployment (SPA on Vercel, API on Render) — optional ---
# Leave ALL of these blank for the default single-service deployment (one Render
# web service serves SPA + API on one origin — no CORS, same-site cookies).
#
# When the client is hosted separately on Vercel:
# CLIENT_ORIGIN — comma-separated origin(s) of the SPA, e.g.
#   https://codeops.vercel.app
# Setting this switches the server into cross-origin mode:
#   - CORS with credentials is answered for these origins,
#   - Better Auth trusts them and issues SameSite=None + Secure session cookies,
#   - GitHub OAuth callback redirects land back on the first origin in the list.
# HTTPS is required on BOTH hosts for cross-site cookies.
CLIENT_ORIGIN=
# BETTER_AUTH_TRUSTED_ORIGINS — comma-separated extra origins Better Auth may
# receive requests from. In split mode CLIENT_ORIGIN is already trusted, so this
# is only needed for additional/oddball origins.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Client (Vercel) build environment — NOT a server var ---
# Set this in the Vercel project's environment (baked into the bundle at build
# time). Points the SPA at this server, e.g. https://codeops.onrender.com.
# If left unset, the SPA calls relative /api/* paths, which the vercel.json
# rewrite proxies to this same server — that mode also works, but direct calls
# are simpler to reason about for cookies.
# VITE_API_URL=https://codeops.onrender.com

# --- GitHub OAuth App (per-user repository connection) ---
# Lets every real account connect their own GitHub account from Settings and
# pull real repositories / open issues / PRs into the workspace.
#
# Create the app: github.com > Settings > Developer settings > OAuth Apps >
# New OAuth App.
#   - Application name: CodeOps
#   - Homepage URL:      the app users see (https://your-app.vercel.app in a
#                        split deployment, or https://codeops.onrender.com when
#                        single-service)
#   - Authorization callback URL: THIS server, ending in /api/github/callback —
#                        https://codeops.onrender.com/api/github/callback
# GitHub OAuth Apps allow ONE callback URL, and it must point at the API server
# (Render), never the Vercel origin — the token exchange runs server-side there.
# It cannot double as a social sign-in provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
# Scopes are requested at runtime: "repo read:user". `repo` covers public and
# private repos (issues/PRs); `read:user` returns the profile. Downgrade to
# `public_repo` only if you never show private repositories.

# --- Optional: stored-token encryption ---
# Dedicated AES-256 key for encrypting GitHub tokens at rest (never plaintext).
# If unset, a key is derived from BETTER_AUTH_SECRET, so rotating that secret
# invalidates stored GitHub tokens (users simply reconnect).
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Optional: demo account ---
# When BOTH are set, a clearly-labeled "Demo" account is provisioned on server
# boot with the seeded product-walkthrough data (Axiom, AutoQA, Notely,
# SignalDock). It can't connect GitHub (its connect button says so honestly).
# Every OTHER account starts empty until it connects its own GitHub.
# Leave blank to ship without a demo account.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Optional: Google social sign-in ---
# Standard OAuth 2.0 web client (Google Cloud Console > Credentials), callback
# https://<this-server>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
