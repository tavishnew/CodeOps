# CodeOps — environment variables
# Copy to .env for local development. On Render, set these in the service dashboard.
# The only required variables are DATABASE_URL and BETTER_AUTH_SECRET. Everything
# else is optional and unlocks a feature when set.

# --- Required ---
# MySQL connection string. Local: the Docker MySQL from the README.
# Production: any MySQL-compatible host (PlanetScale, TiDB Cloud, Aiven, Railway,
# or a self-hosted MySQL 8). Render has no managed MySQL — this must be external.
DATABASE_URL=mysql://local:local@127.0.0.1:3306/codeops
# Better Auth signing secret — generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- GitHub OAuth App (per-user repository connection) ---
# Lets every real account connect their own GitHub account from Settings and
# pull real repositories / open issues / PRs into the workspace.
#
# Create the app: github.com > Settings > Developer settings > OAuth Apps >
# New OAuth App.
#   - Application name: CodeOps
#   - Homepage URL:      https://your-app.example.com (or http://localhost:3000)
#   - Authorization callback URL: https://your-app.example.com/api/github/callback
# GitHub OAuth Apps allow ONE callback URL, so this app must end in
# /api/github/callback. It cannot double as a social sign-in provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
# Scopes are requested at runtime: "repo read:user". `repo` covers public and
# private repos (issues/PRs); `read:user` returns the profile. Downgrade to
# `public_repo` only if you never show private repositories.

# --- Optional: stored-token encryption ---
# Dedicated AES-256 key for encrypting GitHub tokens at rest (never plaintext).
# If unset, a key is derived from BETTER_AUTH_SECRET, so rotating that secret
# invalidates stored GitHub tokens (users simply reconnect).
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Optional: demo account ---
# When BOTH are set, a clearly-labeled "Demo" account is provisioned on server
# boot with the seeded product-walkthrough data (Axiom, AutoQA, Notely,
# SignalDock). It can't connect GitHub (its connect button says so honestly).
# Every OTHER account starts empty until it connects its own GitHub.
# Leave blank to ship without a demo account.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Optional: Google social sign-in ---
# Standard OAuth 2.0 web client (Google Cloud Console > Credentials), callback
# https://your-app.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: runtime ---
# Public URL of this app. Defaults to http://localhost:3000. Set it to the real
# URL in production (e.g. https://codeops.onrender.com) — Better Auth uses it for
# redirects, cookies, and email links.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to authenticate. Only needed if the SPA
# and API live on different origins (see the Vercel-split section of the README).
BETTER_AUTH_TRUSTED_ORIGINS=
# Port the HTTP server binds. Render injects its own PORT; local default is 3000.
PORT=3000
# Runtime environment. Render sets this; local dev defaults to development.
NODE_ENV=development
