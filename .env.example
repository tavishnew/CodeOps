# CodeOps — environment variables
# Copy to .env for local development. On Render, set these in the service dashboard.
# No AI/provider keys are required: the app's AI surfaces are UI copy today, and
# social sign-in keys are optional (email/password auth works without them).

# --- Required ---
# MySQL connection string. Local: the Docker MySQL from the README.
# Production: any MySQL-compatible host (PlanetScale, TiDB Cloud, Aiven, Railway,
# or a self-hosted MySQL 8). Render has no managed MySQL — this must be external.
DATABASE_URL=mysql://local:local@127.0.0.1:3306/codeops
# Better Auth signing secret — generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Optional ---
# Public URL of this app. Defaults to http://localhost:3000. Set it to the real
# URL in production (e.g. https://codeops.onrender.com) — Better Auth uses it for
# redirects, cookies, and email links.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to authenticate. Only needed if the SPA
# and API live on different origins (see the Vercel-split section of the README).
BETTER_AUTH_TRUSTED_ORIGINS=
# Enables GitHub / Google social sign-in buttons on the auth pages.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Port the HTTP server binds. Render injects its own PORT; local default is 3000.
PORT=3000
# Runtime environment. Render sets this; local dev defaults to development.
NODE_ENV=development
